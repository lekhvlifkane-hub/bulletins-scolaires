NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://bulletins:change-me@localhost:5432/bulletins
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,tauri://localhost

# Sessions
SESSION_SECRET=dev-session-secret-change-me-1234567890
SESSION_COOKIE_NAME=bs.sid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=20

# Administrateur général (PLATFORM_ADMIN) : seul lui valide l'inscription des
# établissements. Au démarrage de l'API, si AUCUN administrateur général n'existe,
# le compte référencé ici est créé automatiquement. Jamais appliqué aux comptes
# existants (ni renommé, ni re-créé si l'adresse est déjà prise). Mot de passe
# minimum 12 caractères : CHANGER LE MOT DE PASSE dès la première connexion.
PLATFORM_ADMIN_NAME=Administrateur général
PLATFORM_ADMIN_EMAIL=admin@bulletins-scolaires.sn
PLATFORM_ADMIN_PASSWORD=Bulletins@Admin2026

# Base dédiée aux tests d'intégration (jamais la base de développement)
TEST_DATABASE_URL=postgresql://bulletins:change-me@localhost:5433/bulletins_test

# Base dédiée aux tests E2E (scripts prepare-e2e.mjs / run-e2e.mjs)
E2E_DATABASE_URL=postgresql://bulletins:change-me@localhost:5433/bulletins_e2e

# Mot de passe des comptes de démonstration (npm run seed:demo, local uniquement).
# Optionnel : sans lui, un secret aléatoire est généré et affiché une seule fois.
# Minimum 12 caractères. Jamais en production (le seed refuse NODE_ENV=production).
SEED_PASSWORD=
