generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  SURVEILLANT_GENERAL
  ASSISTANT
}

enum AcademicYearStatus {
  PREPARATION
  ACTIVE
  CLOSED
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  LEFT
  ARCHIVED
}

enum EnrollmentEntryType {
  NEW
  TRANSFERRED
}

/// Catégorie d'évaluation : entre dans la formule de la moyenne de matière selon les poids de l'établissement.
enum EvaluationCategory {
  DEVOIR
  COMPOSITION
  AUTRE
}

/// Workflow d'une évaluation : brouillon → saisie → à vérifier → validée → publiée.
enum AssessmentStatus {
  BOUILLON
  SAISIE_EN_COURS
  A_VERIFIER
  VALIDEE
  PUBLIEE
}

/// Statut d'une note. Un 0 n'est une note valide que si status = SAISIE.
enum GradeStatus {
  SAISIE
  ABSENT
  ANNULEE
  NON_SAISIE
}

/// Statut d'un bulletin (phase 5). Un bulletin PUBLIE est figé : sa correction
/// passe par une nouvelle version, l'ancienne restant conservée.
enum ReportCardStatus {
  BOUILLON
  PRET
  PUBLIE
  ANNULE
}

enum AttendanceKind {
  ABSENCE
  RETARD
}

enum CouncilDecisionStatus {
  BROUILLON
  VALIDEE
}

enum SchoolStatus {
  PENDING
  ACTIVE
  REJECTED
}

/// Mode de gestion des comptes d'un établissement.
/// - SOLO : un seul compte client, sans gestion d'équipe (nouvelles inscriptions).
/// - EQUIPE : plusieurs comptes avec rôles (établissements existants, rétrocompatibilité).
enum AccountMode {
  SOLO
  EQUIPE
}

/// Nature d'une règle d'appréciation automatique.
/// - MATIERE : appréciation par discipline selon la moyenne de la matière.
/// - MENTION : mention globale du bulletin selon la moyenne générale.
/// - DECISION : décision proposée au conseil de classe.
/// - GENERALE : modèle de texte d'appréciation générale.
enum AppreciationRuleScope {
  MATIERE
  MENTION
  DECISION
  GENERALE
}

// Métadonnées techniques de la base (version de schéma, informations de déploiement).
model AppMeta {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Paramètres de sauvegarde (table singleton conservée pour compatibilité).
model BackupSetting {
  id                  String    @id @default("singleton")
  actif               Boolean   @default(false)
  heure               Int       @default(2)
  retentionJours      Int       @default(30)
  derniereTentativeAt DateTime?
  derniereReussiteAt  DateTime?
  dernierStatut       String?
  dernierMessage      String?
  updatedAt           DateTime  @updatedAt
}

model School {
  id                  String       @id @default(cuid())
  name                String
  officialName        String?
  iefName             String       @default("IEF Thiès")
  city                String?
  address             String?
  phone               String?
  email               String?
  accreditationNumber String?
  headmasterName      String?
  logoDataUrl         String?      @db.Text
  status              SchoolStatus @default(ACTIVE)
  accountMode         AccountMode  @default(EQUIPE)
  isActive            Boolean      @default(true)

  // Règles de calcul de l'établissement (defaults = valeurs à valider, voir docs/A_VALIDER.md)
  regleCalculMatiere         String  @default("POIDS_GROUPES")
  poidsDevoirs               Decimal @default(1) @db.Decimal(5, 2)
  poidsCompositions          Decimal @default(1) @db.Decimal(5, 2)
  poidsAutres                Decimal @default(0) @db.Decimal(5, 2)
  absencesComptentZero       Boolean @default(false)
  groupeSansNote             String  @default("EXCLURE")
  coefficientInvalide        String  @default("EXCLURE")
  baremeParDefaut            Decimal @default(20) @db.Decimal(5, 2)
  arrondiDecimales           Int     @default(2)
  arrondiMode                String  @default("HALF_UP")
  rangMode                   String  @default("STANDARD")
  classerResultatsIncomplets Boolean @default(false)
  poidsSemestre1             Decimal @default(1) @db.Decimal(5, 2)
  poidsSemestre2             Decimal @default(1) @db.Decimal(5, 2)
  annuelSiSemestreManquant   String  @default("NULL")

  // Modèle officiel des bulletins CEM et identité visuelle configurable.
  seuilPassage             Decimal @default(10) @db.Decimal(5, 2)
  modeleBulletin           String  @default("OFFICIEL")
  couleurPrimaire          String  @default("#0B2D4F")
  couleurSecondaire        String  @default("#0B9B67")
  couleurAccent            String  @default("#E5B544")
  drapeauDataUrl           String? @db.Text
  logoMinistereDataUrl     String? @db.Text

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users             User[]
  auditLogs         AuditLog[]
  temporaryAccess   TemporaryAccessGrant[]
  academicYears     AcademicYear[]
  levels            Level[]
  series            Series[]
  classrooms        Classroom[]
  students          Student[]
  subjects          Subject[]
  attendanceRecords AttendanceRecord[]
  appreciations     Appreciation[]
  appreciationRules AppreciationRule[]
  councilDecisions  CouncilDecision[]
  subjectChoices    StudentSubjectChoice[]

  @@index([deletedAt])
}

model AcademicYear {
  id               String             @id @default(cuid())
  schoolId         String
  school           School             @relation(fields: [schoolId], references: [id])
  name             String
  startsAt         DateTime
  endsAt           DateTime
  status           AcademicYearStatus @default(PREPARATION)
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  semesters        Semester[]
  classrooms       Classroom[]
  reportCards      ReportCard[]
  annualSummaries  AnnualSummary[]
  councilDecisions CouncilDecision[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
}

model Semester {
  id                String             @id @default(cuid())
  academicYearId    String
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  number            Int
  name              String
  startsAt          DateTime
  endsAt            DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assessments       Assessment[]
  reportCards       ReportCard[]
  attendanceRecords AttendanceRecord[]
  appreciations     Appreciation[]

  @@unique([academicYearId, number])
}

model Level {
  id         String      @id @default(cuid())
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id])
  name       String
  sortOrder  Int         @default(0)
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  series     Series[]
  classrooms Classroom[]
  subjects   Subject[]

  @@unique([schoolId, name])
}

model Series {
  id         String      @id @default(cuid())
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id])
  levelId    String?
  level      Level?      @relation(fields: [levelId], references: [id])
  name       String
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  classrooms Classroom[]

  @@unique([schoolId, levelId, name])
}

model Classroom {
  id              String             @id @default(cuid())
  schoolId        String
  school          School             @relation(fields: [schoolId], references: [id])
  academicYearId  String
  academicYear    AcademicYear       @relation(fields: [academicYearId], references: [id])
  levelId         String
  level           Level              @relation(fields: [levelId], references: [id])
  seriesId        String?
  series          Series?            @relation(fields: [seriesId], references: [id])
  name            String
  /// Professeur principal affiché sur le bulletin (champ libre).
  mainTeacherName String?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  enrollments     Enrollment[]
  subjects        ClassroomSubject[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, academicYearId])
}

model Student {
  id            String       @id @default(cuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id])
  matricule     String
  lastName      String
  firstNames    String
  birthDate     DateTime?
  birthPlace    String?
  sex           String?
  address       String?
  guardianName  String?
  guardianPhone String?
  /// Identifiant national de l'élève (IEN), affiché sur le bulletin officiel.
  ien           String?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  enrollments   Enrollment[]

  @@unique([schoolId, matricule])
  @@index([schoolId, lastName, firstNames])
}

model Enrollment {
  id                String               @id @default(cuid())
  schoolId          String
  studentId         String
  student           Student              @relation(fields: [studentId], references: [id])
  classroomId       String
  classroom         Classroom            @relation(fields: [classroomId], references: [id])
  status            EnrollmentStatus     @default(ACTIVE)
  entryType         EnrollmentEntryType?
  /// Élève redoublant pour cette inscription (jamais une propriété permanente de l'élève).
  isRepeating       Boolean              @default(false)
  enrolledAt        DateTime             @default(now())
  endedAt           DateTime?
  deletedAt         DateTime?
  grades            Grade[]
  reportCards       ReportCard[]
  annualSummaries   AnnualSummary[]
  attendanceRecords AttendanceRecord[]
  appreciations     Appreciation[]
  councilDecisions  CouncilDecision[]
  subjectChoices    StudentSubjectChoice[]

  @@index([schoolId, studentId])
  @@index([schoolId, classroomId, status])
}

model Subject {
  id            String                 @id @default(cuid())
  schoolId      String
  school        School                 @relation(fields: [schoolId], references: [id])
  name          String
  code          String
  /// Niveau auquel le modèle de matière s'applique (6e, 5e, 4e, 3e…).
  levelId       String?
  level         Level?                 @relation(fields: [levelId], references: [id])
  /// Groupe parent, par exemple « Français » pour Rédaction/Orthographe.
  parentId      String?
  parent        Subject?               @relation("SubjectParent", fields: [parentId], references: [id])
  children      Subject[]              @relation("SubjectParent")
  coefficient   Decimal                @default(1) @db.Decimal(6, 2)
  sortOrder     Int                    @default(0)
  isActive      Boolean                @default(true)
  /// Matière à choix par élève (LV2 par exemple).
  isChoice      Boolean                @default(false)
  deletedAt     DateTime?
  createdAt     DateTime               @default(now())
  classrooms    ClassroomSubject[]
  appreciations Appreciation[]
  subjectChoices StudentSubjectChoice[]

  @@unique([schoolId, code])
  @@index([schoolId, levelId, sortOrder])
}

model ClassroomSubject {
  id            String       @id @default(cuid())
  schoolId      String
  classroomId   String
  classroom     Classroom    @relation(fields: [classroomId], references: [id])
  subjectId     String
  subject       Subject      @relation(fields: [subjectId], references: [id])
  coefficient   Decimal      @db.Decimal(6, 2)
  sortOrder     Int          @default(0)
  isActive      Boolean      @default(true)
  /// Enseignant affiché sur le bulletin : champ libre, non un compte utilisateur.
  teacherName   String?
  effectiveFrom DateTime     @default(now())
  effectiveTo   DateTime?
  assessments   Assessment[]

  @@index([schoolId, classroomId])
  @@index([schoolId, subjectId])
}

/// Choix d'une matière « à option » pour un élève (LV2 en 4e par exemple).
model StudentSubjectChoice {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([enrollmentId])
  @@index([schoolId, subjectId])
}

model User {
  id                  String    @id @default(cuid())
  schoolId            String?
  school              School?   @relation(fields: [schoolId], references: [id])
  name                String
  email               String    @unique
  passwordHash        String
  role                Role
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  auditLogs              AuditLog[]             @relation("AuditActor")
  grantedAccess          TemporaryAccessGrant[] @relation("GrantedBy")
  platformAccessGrants   TemporaryAccessGrant[] @relation("PlatformAdmin")
  bulletinsGeneres       ReportCard[]           @relation("BulletinAuteur")
  bulletinsPublies       ReportCard[]           @relation("BulletinPublieur")
  attendanceRecords      AttendanceRecord[]     @relation("AttendanceRecorder")
  appreciationsCreees    Appreciation[]         @relation("AppreciationCreator")
  appreciationsModifiees Appreciation[]         @relation("AppreciationUpdater")
  decisionsValidees      CouncilDecision[]      @relation("CouncilDecisionValidator")

  @@index([schoolId, role])
  @@index([deletedAt])
}

model TemporaryAccessGrant {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id])
  platformAdminId String
  platformAdmin   User      @relation("PlatformAdmin", fields: [platformAdminId], references: [id])
  grantedById     String
  grantedBy       User      @relation("GrantedBy", fields: [grantedById], references: [id])
  reason          String
  startsAt        DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([schoolId, expiresAt])
  @@index([platformAdminId])
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id])
  userId     String?
  user       User?    @relation("AuditActor", fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
}

/// Type d'évaluation configurable par établissement (devoir, composition, interrogation…).
model AssessmentType {
  id           String             @id @default(cuid())
  schoolId     String
  code         String
  name         String
  category     EvaluationCategory
  defaultOutOf Decimal            @default(20) @db.Decimal(5, 2)
  actif        Boolean            @default(true)
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  assessments  Assessment[]

  @@unique([schoolId, code])
  @@index([schoolId, category])
}

/// Évaluation rattachée à un couple classe/discipline pour un semestre donné.
/// L'unicité (établissement, classe+discipline, semestre, type, position) empêche le doublon.
model Assessment {
  id                 String           @id @default(cuid())
  schoolId           String
  classroomSubjectId String
  classroomSubject   ClassroomSubject @relation(fields: [classroomSubjectId], references: [id])
  semesterId         String
  semester           Semester         @relation(fields: [semesterId], references: [id])
  typeId             String
  type               AssessmentType   @relation(fields: [typeId], references: [id])
  title              String
  position           Int              @default(1)
  outOf              Decimal          @default(20) @db.Decimal(5, 2)
  status             AssessmentStatus @default(BOUILLON)
  date               DateTime?
  validatedAt        DateTime?
  publishedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  grades             Grade[]

  @@unique([schoolId, classroomSubjectId, semesterId, typeId, position])
  @@index([schoolId, semesterId])
  @@index([schoolId, status])
}

/// Note. `enrollmentId` et non `studentId` : l'historique d'inscription est conservé.
model Grade {
  id           String      @id @default(cuid())
  schoolId     String
  assessmentId String
  assessment   Assessment  @relation(fields: [assessmentId], references: [id])
  enrollmentId String
  enrollment   Enrollment  @relation(fields: [enrollmentId], references: [id])
  score        Decimal?    @db.Decimal(5, 2)
  status       GradeStatus @default(NON_SAISIE)
  observation  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@unique([assessmentId, enrollmentId])
  @@index([schoolId, enrollmentId])
  @@index([schoolId, assessmentId])
  @@index([schoolId, deletedAt])
}

model AttendanceRecord {
  id              String         @id @default(cuid())
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id])
  enrollmentId    String
  enrollment      Enrollment     @relation(fields: [enrollmentId], references: [id])
  semesterId      String
  semester        Semester       @relation(fields: [semesterId], references: [id])
  kind            AttendanceKind
  date            DateTime       @db.Date
  justified       Boolean        @default(false)
  durationMinutes Int?
  reason          String?
  recordedById    String?
  recordedBy      User?          @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([schoolId, enrollmentId, semesterId, deletedAt])
  @@index([schoolId, semesterId, date])
}

model Appreciation {
  id            String     @id @default(cuid())
  schoolId      String
  school        School     @relation(fields: [schoolId], references: [id])
  enrollmentId  String
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id])
  semesterId    String
  semester      Semester   @relation(fields: [semesterId], references: [id])
  subjectId     String
  subject       Subject    @relation(fields: [subjectId], references: [id])
  content       String
  /// true = texte produit par le moteur ; false = texte saisi/modifié par un utilisateur.
  autoGenerated Boolean    @default(false)
  createdById   String?
  createdBy     User?      @relation("AppreciationCreator", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     User?      @relation("AppreciationUpdater", fields: [updatedById], references: [id])
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([enrollmentId, semesterId, subjectId])
  @@index([schoolId, enrollmentId, semesterId, deletedAt])
}

/// Seuil configurable par établissement pour les appréciations automatiques.
/// `minScore` et `maxScore` bornent l'intervalle affiché ; la sélection se fait
/// sur le seuil bas le plus élevé atteint, ce qui évite les trous de frontière.
model AppreciationRule {
  id        String                @id @default(cuid())
  schoolId  String
  school    School                @relation(fields: [schoolId], references: [id])
  scope     AppreciationRuleScope
  code      String
  label     String
  minScore  Decimal?              @db.Decimal(5, 2)
  maxScore  Decimal?              @db.Decimal(5, 2)
  content   String                @db.Text
  sortOrder Int                   @default(0)
  isActive  Boolean               @default(true)
  deletedAt DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([schoolId, scope, code])
  @@index([schoolId, scope, isActive])
}

model CouncilDecision {
  id                 String                @id @default(cuid())
  schoolId           String
  school             School                @relation(fields: [schoolId], references: [id])
  enrollmentId       String
  enrollment         Enrollment            @relation(fields: [enrollmentId], references: [id])
  academicYearId     String
  academicYear       AcademicYear          @relation(fields: [academicYearId], references: [id])
  version            Int                   @default(1)
  status             CouncilDecisionStatus @default(BROUILLON)
  isCurrent          Boolean               @default(true)
  content            String
  previousDecisionId String?
  previousDecision   CouncilDecision?      @relation("CouncilDecisionHistory", fields: [previousDecisionId], references: [id])
  nextDecisions      CouncilDecision[]     @relation("CouncilDecisionHistory")
  validatedAt        DateTime?
  validatedById      String?
  validatedBy        User?                 @relation("CouncilDecisionValidator", fields: [validatedById], references: [id])
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([enrollmentId, academicYearId, version])
  @@index([schoolId, academicYearId, status, isCurrent])
}

/// Bulletin de notes versionné (phase 5).
/// `snapshot` est la photo figée des données utilisées à la génération : moyennes,
/// coefficients, notes retenues, paramètres et formules de l'établissement, en-tête.
/// Un bulletin PUBLIE ne se remanie jamais : une correction crée une `version`
/// supérieure, l'ancienne restant consultable (`estCourant` = false).
/// Les colonnes de synthèse recopient le snapshot pour lister/trier sans lire le JSON ;
/// la source d'affichage reste le snapshot.
model ReportCard {
  id                   String           @id @default(cuid())
  schoolId             String
  enrollmentId         String
  enrollment           Enrollment       @relation(fields: [enrollmentId], references: [id])
  semesterId           String
  semester             Semester         @relation(fields: [semesterId], references: [id])
  academicYearId       String
  academicYear         AcademicYear     @relation(fields: [academicYearId], references: [id])
  version              Int              @default(1)
  statut               ReportCardStatus @default(BOUILLON)
  estCourant           Boolean          @default(true)
  remplaceReportCardId String?
  remplaceReportCard   ReportCard?      @relation("BulletinCorrection", fields: [remplaceReportCardId], references: [id])
  corrigePar           ReportCard[]     @relation("BulletinCorrection")
  motifCorrection      String?
  snapshot             Json

  moyenneGenerale       Decimal? @db.Decimal(6, 4)
  moyenneGeneraleExacte String?
  moyenneClasse         Decimal? @db.Decimal(6, 4)
  effectif              Int?
  rang                  Int?
  motifNonClasse        String?
  totalPoints           Decimal? @db.Decimal(10, 4)
  totalCoeficients      Decimal? @db.Decimal(10, 2)
  incomplet             Boolean  @default(false)
  motifs                String[] @default([])

  /// Renseignés par le moteur ou par l'établissement, jamais inventés.
  mention          String?
  decisionConseil  String?
  appreciation     String?
  /// false dès qu'un utilisateur remplace le texte automatique.
  mentionAuto      Boolean @default(true)
  decisionAuto     Boolean @default(true)
  appreciationAuto Boolean @default(true)

  genereLe    DateTime  @default(now())
  valideLe    DateTime?
  publieLe    DateTime?
  genereParId String?
  generePar   User?     @relation("BulletinAuteur", fields: [genereParId], references: [id])
  publieParId String?
  publiePar   User?     @relation("BulletinPublieur", fields: [publieParId], references: [id])
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([enrollmentId, semesterId, version])
  @@index([schoolId, semesterId, statut])
  @@index([schoolId, enrollmentId])
  @@index([schoolId, academicYearId])
  @@index([remplaceReportCardId])
}

/// Bilan annuel d'un élève : S1, S2 et moyenne annuelle selon la règle de l'établissement.
/// Un semestre manquant rend l'annuelle non calculable (jamais une valeur inventée) ;
/// le snapshot garde les deux bulletins retenus.
model AnnualSummary {
  id             String           @id @default(cuid())
  schoolId       String
  enrollmentId   String
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id])
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id])
  version        Int              @default(1)
  statut         ReportCardStatus @default(BOUILLON)
  estCourant     Boolean          @default(true)
  snapshot       Json

  s1ReportCardId String?
  s2ReportCardId String?

  moyenneS1             Decimal? @db.Decimal(6, 4)
  moyenneS2             Decimal? @db.Decimal(6, 4)
  moyenneAnnuelle       Decimal? @db.Decimal(6, 4)
  moyenneAnnuelleExacte String?
  calculable            Boolean  @default(false)
  partiel               Boolean  @default(false)
  rangAnnuel            Int?
  effectif              Int?
  motifs                String[] @default([])

  mention          String?
  decisionConseil  String?
  appreciation     String?
  mentionAuto      Boolean @default(true)
  decisionAuto     Boolean @default(true)
  appreciationAuto Boolean @default(true)

  genereLe  DateTime  @default(now())
  publieLe  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([enrollmentId, academicYearId, version])
  @@index([schoolId, academicYearId, statut])
  @@index([schoolId, enrollmentId])
}
