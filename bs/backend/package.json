{
  "name": "bulletins-scolaires-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de Bulletins Scolaires",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:real": "node scripts/run-e2e.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "create-platform-admin": "tsx scripts/create-platform-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:backup": "node scripts/backup-db.mjs",
    "db:test-restore": "node scripts/test-restore.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.16.0",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
