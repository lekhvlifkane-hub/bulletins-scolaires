# Copier ce fichier en .env puis adapter les valeurs (optionnel en dev).
# Jamais de secret côté frontend : tout passe par le proxy Vite vers le backend.

# Cible du proxy VITE pour les requêtes /api en développement.
# Correspond au PORT du backend (backend/.env).
VITE_API_PROXY_TARGET=http://localhost:4000

# URL absolue de l'API, si besoin de contourner le proxy (ex. backend distant).
# Laisser vide en dev. En app Tauri packagée, détectée automatiquement (http://localhost:4000).
# VITE_API_BASE_URL=http://localhost:4000
