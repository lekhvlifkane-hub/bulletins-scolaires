{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulletins Scolaires",
  "version": "0.1.6",
  "identifier": "sn.bulletins.scolaires",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bulletins Scolaires",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Nouhoudiallo/bulletins-scolaires-updates/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERDQ4QkFFQjlDQTQ3ODQKUldTRVI4cTVyb3ZVemQ4QzR2WjRzVDlhN0RnRlpLK0N1OGo4alVrbDh5dEgrMndoRURqQXFjdnoK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
