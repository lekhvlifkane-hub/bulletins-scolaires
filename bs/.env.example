# Copier ce fichier en .env puis adapter les valeurs.
# Ne jamais committer .env.

NODE_ENV=development
POSTGRES_USER=bulletins
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bulletins
POSTGRES_PORT=5432

BACKEND_PORT=4000

# Origines autorisées pour le frontend Tauri (Windows : http://tauri.localhost)
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,tauri://localhost

# Sessions (remplacer le secret avant toute mise en production)
SESSION_SECRET=dev-session-secret-change-me-1234567890
SESSION_COOKIE_NAME=bs.sid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=20

# Adresse publique de l'interface : sert à construire les liens envoyés par e-mail
APP_BASE_URL=http://localhost:1420

# Fournisseur d'envoi des e-mails (laisser vide en développement)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
